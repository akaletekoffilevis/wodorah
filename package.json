{
	"name": "wodorah",
	"description": "Site institutionnel bilingue de Wodorah.",
	"dependencies": {
		"@arcjet/next": "^1.14.1",
		"@base-ui/react": "^1.9.0",
		"@opennextjs/cloudflare": "^1.20.9",
		"arcjet": "^1.14.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.0",
		"isomorphic-dompurify": "^4.6.0",
		"lucide-react": "^1.61.0",
		"next": "^16.4.2",
		"next-auth": "^5.0.0-beta.32",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.1.17",
		"@types/node": "^24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"eslint": "9.39.2",
		"eslint-config-next": "^16.4.2",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn": "^4.22.1",
		"tailwindcss": "4.1.17",
		"typescript": "5.9.3",
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	},
	"private": true,
	"scripts": {
		"build": "next build",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"dev": "next dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"start": "next start",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	}
}
